# Firebase web config for the superkids-prod project.
# Fill in the real values from the Firebase console: Project settings > General.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=superkids-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=superkids-prod
VITE_FIREBASE_STORAGE_BUCKET=superkids-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Production must never use the emulator.
VITE_USE_EMULATOR=false
