# Firebase web config for the superkids-dev project.
# These values are public by design (Security Rules are the real boundary),
# but keep them in env files — never hard-coded in source.
# Fill in the real values from the Firebase console: Project settings > General.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=superkids-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=superkids-dev
VITE_FIREBASE_STORAGE_BUCKET=superkids-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to connect to the local Firebase Emulator Suite instead of the cloud.
VITE_USE_EMULATOR=true
