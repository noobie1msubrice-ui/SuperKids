rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /storeItems/{parentId}/{fileName} {
      // Any signed-in user may read an item image.
      allow read: if request.auth != null;
      // Only the owning parent may upload; <= 5 MB; images only.
      allow write: if request.auth != null
        && request.auth.uid == parentId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /avatars/{uid}/{fileName} {
      // Any signed-in user may read a profile picture.
      allow read: if request.auth != null;
      // Only the account owner may upload their own; <= 5 MB; images only.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /taskEvidence/{taskId}/{fileName} {
      // Anyone signed in may view evidence (the assigned kid, their parent,
      // and admins inside their respective UIs).
      allow read: if request.auth != null;
      // Any signed-in user may upload an image <= 5 MB here. Ownership is
      // enforced where it matters: the Firestore task-update rule only lets
      // the assigned kid attach an evidenceUrl to *their* task, so an upload
      // to someone else's taskId is harmless (it can never be linked).
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
